{
  "name": "pack-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite web",
    "build": "vite build web",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hono": "4.13.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}
